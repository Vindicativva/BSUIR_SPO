<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jilba.ui.ResultController"
      spacing="12"
      prefWidth="750.0"
      prefHeight="650.0">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <Label text="Синтаксическое дерево (AST):"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <!-- Область отображения AST-дерева -->
    <TextArea fx:id="astArea"
              editable="false"
              wrapText="true"
              VBox.vgrow="ALWAYS"
              style="-fx-font-family: 'Consolas', 'Courier New', monospace;
                     -fx-font-size: 12.5px; -fx-background-color: #fafafa;"/>

    <!-- Контрастная панель метрик сложности Джилба -->
    <VBox spacing="6"
          style="-fx-background-color: #f8f9fa; -fx-border-color: #dee2e6;
                 -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 12;">
        <Label text="Метрики сложности Джилба:"
               style="-fx-font-size: 12px; -fx-font-weight: bold; -fx-text-fill: #495057;"/>
        <HBox spacing="30" alignment="CENTER_LEFT">
            <Label fx:id="absoluteComplexityLabel"
                   text="CL = 0"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #c62828;"/>
            <Label fx:id="relativeComplexityLabel"
                   text="cl = 0.0000"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1565c0;"/>
            <Label fx:id="maxNestingLevelLabel"
                   text="CLI = 0"
                   style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #2e7d32;"/>
        </HBox>
    </VBox>

    <!-- Нижняя панель с кнопкой закрытия окна -->
    <HBox alignment="CENTER_RIGHT">
        <Button text="Закрыть"
                onAction="#handleClose"
                cancelButton="true"
                style="-fx-font-size: 13px; -fx-padding: 6 22; -fx-cursor: hand; -fx-background-radius: 4;"/>
    </HBox>
</VBox>
