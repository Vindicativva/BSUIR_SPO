<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="jilba.ui.MainController"
      spacing="10"
      prefWidth="850.0"
      prefHeight="650.0">
    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <!-- Верхняя панель выбора файла -->
    <HBox spacing="12" alignment="CENTER_LEFT">
        <Button text="Выбрать файл"
                onAction="#handleOpenFile"
                style="-fx-font-size: 13px; -fx-padding: 6 14; -fx-cursor: hand;"/>
        <Label fx:id="filePathLabel"
               text="Файл не выбран"
               style="-fx-font-size: 13px; -fx-text-fill: #555555;"/>
    </HBox>

    <Label text="Исходный код JavaScript:"
           style="-fx-font-size: 13px; -fx-font-weight: bold;"/>

    <!-- Область ввода JavaScript-кода -->
    <TextArea fx:id="codeArea"
              wrapText="true"
              VBox.vgrow="ALWAYS"
              style="-fx-font-family: 'Consolas', 'Courier New', monospace; -fx-font-size: 13px;"/>

    <!-- Нижняя панель управления с акцентной кнопкой расчета -->
    <HBox alignment="CENTER_RIGHT" spacing="10">
        <Button fx:id="calculateButton"
                text="Рассчитать сложность"
                onAction="#handleCalculate"
                defaultButton="true"
                style="-fx-background-color: #1976d2; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 8 22; -fx-cursor: hand; -fx-background-radius: 4;"/>
    </HBox>
</VBox>
